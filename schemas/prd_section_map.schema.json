{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/hplan_codex/schemas/prd_section_map.schema.json",
  "title": "hplan PRD Section Map",
  "type": "object",
  "required": ["schema_version", "source", "sections"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source": {
      "type": "string",
      "description": "PRD source path, usually harness/PRD.md."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "title", "status"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["present", "missing", "incomplete"]
          },
          "artifact_path": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
