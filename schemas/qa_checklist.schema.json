{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kimsanguine/hplan_codex/schemas/qa_checklist.schema.json",
  "title": "hplan QA Checklist",
  "type": "object",
  "required": ["schema_version", "source_prd", "items"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_prd": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "steps", "expected_result", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_result": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["todo", "pass", "fail", "blocked"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
